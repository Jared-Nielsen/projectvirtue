        "unlocks": ["sheep"],
        "locks": [],
        "sideEffects": []
      },
      "resp_iolo_lute": {
        "id": "resp_iolo_lute",
        "text": {
          "key": "iolo.lute",
          "en": "An old oak lute, given me by Gwenno before she went south. I shall not pawn it. Do not ask."
        },
        "unlocks": ["song"],
        "locks": [],
        "sideEffects": []
      },
      "resp_iolo_song": {
        "id": "resp_iolo_song",
        "text": {
          "key": "iolo.song",
          "en": "Three coppers buys thee one verse. Five buys thee silence. The choice is thine."
        },
        "unlocks": [],
        "locks": [],
        "sideEffects": []
      },
