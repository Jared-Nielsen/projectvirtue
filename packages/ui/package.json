    "storybook": "8.6.17",
    "storybook-solidjs": "1.0.0-beta.7",
    "storybook-solidjs-vite": "1.0.0-beta.7",
    "typescript": "5.6.3",
    "vite": "6.4.2",
    "vite-plugin-solid": "2.10.2",
    "vitest": "2.1.9"
  }
