# @br/web — game-client environment. Copy to .env.local (gitignored)
# and fill in for local dev. Vite inlines values prefixed with `VITE_`
# into the browser bundle — never put a private secret here.

# ---- CDN base ---------------------------------------------------------
# Cloudflare R2 base URL for production tile / sprite / interface / monster
# art. Currently hardcoded to media.gamecodex.com in the Tiled .tmx and
# the editor manifest; these env vars are the migration target so per-
# environment overrides become possible (e.g. preview deploys → preview-
# media.gamecodex.com staging bucket).
VITE_R2_BASE_URL=https://media.gamecodex.com

# ---- Marketing site link-back ----------------------------------------
# Where the game client links to the marketing site (e.g. for the
# "Sign out" → home redirect). Defaults to local dev.
VITE_SITE_BASE_URL=http://localhost:5174

# ---- Real backend (Phase 2+) -----------------------------------------
# When the Rust authoritative server lands (Doc #41), MockClient is
# replaced with a real fetch client pointed at this base URL. Empty
# value keeps the in-process mock as the data source.
VITE_API_BASE_URL=

# ---- Telemetry (Phase 7) ---------------------------------------------
# Plausible-shaped analytics — domain to attribute events to. Empty
# disables real reporting (the analytics stub is a no-op without this).
VITE_PLAUSIBLE_DOMAIN=

# Sentry-shaped crash reporting — DSN. Empty disables real reporting.
VITE_SENTRY_DSN=
