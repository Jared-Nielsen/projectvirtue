---
import WorldMap from '../../islands/WorldMap.tsx';
import BaseLayout from '../../layouts/BaseLayout.astro';

const description =
  'Explore Mythenor — interactive map of cities, dungeons, and wilderness regions across the realm.';
---

<BaseLayout title="World Map" description={description}>
  <section class="worlds-hero" aria-labelledby="map-title">
    <div class="container">
      <h1 id="map-title">The Map of Mythenor</h1>
      <p class="lede">
        Explore the realm. Click any region for its lore. Wheel-zoom or pinch to study a feature in
        detail.
      </p>
      <p>
        <a href="/worlds" class="cta cta--ghost">← Back to shards</a>
      </p>
    </div>
  </section>
  <section class="section" aria-label="Interactive map">
    <div class="container">
      <WorldMap client:visible />
    </div>
  </section>
</BaseLayout>

<style>
  .worlds-hero { padding: 48px 0 16px; }
</style>
