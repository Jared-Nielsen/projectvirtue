---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import CookieBanner from '../islands/CookieBanner.tsx';

export interface Props {
  /** Short page title; rendered as `${title} — Project Virtue`. Pass an empty
   * string for the homepage to use the bare brand title. */
  readonly title: string;
  readonly description: string;
  /** Optional override; defaults to `/og-image.svg`. */
  readonly ogImage?: string;
  /** Page-level JSON-LD payload — rendered as <script type="application/ld+json">. */
  readonly jsonLd?: Record<string, unknown>;
}

const SITE_NAME = 'Project Virtue';
const SITE_BASE = 'https://virtu3.com';

const { title, description, ogImage = '/og-image.svg', jsonLd } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = `${SITE_BASE}${pathname === '/' ? '/' : pathname}`;
const fullTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — A journey, a choice, a life.`;
const ogTitle = title ? `${title} — ${SITE_NAME}` : 'Project Virtue — A journey, a choice, a life.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0c0d11" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={pathname.startsWith('/journal/') && pathname !== '/journal' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{fullTitle}</title>

    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <div class="site-shell">
      <a href="#main" class="skip-link">Skip to main content</a>
      <Header />
      <main id="main" class="site-main" tabindex="-1">
        <slot />
      </main>
      <Footer />
      <CookieBanner client:idle />
    </div>
  </body>
</html>
