# @br/site — marketing site (Astro static) environment. Copy to
# .env.local (gitignored) and fill in for local dev. Astro inlines
# values prefixed with `PUBLIC_` into the browser bundle — never
# put a private secret here.

# ---- CDN base ---------------------------------------------------------
# Cloudflare R2 base URL for marketing-site media (hero images, OG
# previews, etc. once we move them off public/).
PUBLIC_R2_BASE_URL=https://media.gamecodex.com

# ---- Game client link-out --------------------------------------------
# Where the "Open World Editor →" CTA on /worlds (and similar CTAs)
# point to. Empty falls back to a relative path (`/play/editor`),
# which only works when the marketing site and game client share an
# origin — set this when they don't.
PUBLIC_GAME_BASE_URL=

# ---- Telemetry (consent-gated) ---------------------------------------
# Plausible-shaped analytics. The site's CookieBanner has to grant
# consent before anything is sent regardless of this value.
PUBLIC_PLAUSIBLE_DOMAIN=virtu3.com
PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# ---- Newsletter signup (mocked today) --------------------------------
# When the newsletter form moves off the local-only mock, point at the
# real provider (ConvertKit, Beehiiv, etc.). Server-only secrets stay
# in repo-root .env, not here.
PUBLIC_NEWSLETTER_FORM_ID=
