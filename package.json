{
  "name": "project-virtue",
  "version": "0.0.0",
  "private": true,
  "description": "Project Virtue frontend monorepo (UO-inspired MMORPG).",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r test --run",
    "preview": "pnpm -r --parallel --filter \"./apps/*\" preview"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "overrides": {
      "@storybook/builder-vite": "8.6.17",
      "@storybook/types": "8.6.17",
      "vite": "^6.4.2",
      "esbuild": "^0.25.0",
      "yaml": "^2.8.3"
    }
  }
}
