{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",

    "deny": [
      "Bash(sudo rm*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf --no-preserve-root*)",
      "Bash(mkfs*)",
      "Bash(dd *of=/dev/*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(halt*)",
      "Bash(poweroff*)",

      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit *--no-gpg-sign*)",
      "Bash(git update-ref -d*)",
      "Bash(git reflog expire*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/id_ed25519)",
      "Read(**/id_ed25519.*)",
      "Read(/home/jnfz/.ssh/**)",
      "Read(/home/jnfz/.aws/**)",
      "Read(/home/jnfz/.gnupg/**)",
      "Read(/home/jnfz/.claude/.credentials.json)",
      "Read(/home/jnfz/.claude/credentials.json)",

      "Edit(/home/jnfz/.claude/**)",
      "Write(/home/jnfz/.claude/**)",
      "Edit(/etc/**)",
      "Write(/etc/**)",
      "Edit(/home/jnfz/.ssh/**)",
      "Write(/home/jnfz/.ssh/**)"
    ],

    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git restore --staged .)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete --force*)",
      "Bash(git rebase --onto*)",
      "Bash(git tag -d*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git submodule deinit*)",

      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(sudo *)",

      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(npm install -g*)",
      "Bash(npm i -g*)",
      "Bash(pnpm add -g*)",
      "Bash(yarn global add*)",
      "Bash(npm uninstall*)",
      "Bash(npm remove*)",

      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",

      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker rm -f*)",
      "Bash(docker rmi -f*)",

      "Bash(curl * --output*)",
      "Bash(curl * -o*)",
      "Bash(wget *)"
    ],

