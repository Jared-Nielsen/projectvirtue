  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/safety-hook.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
