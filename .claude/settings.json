      "Bash(stat *)",
      "Bash(tree*)",
      "Bash(diff *)",
      "Bash(date*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(true)",
      "Bash(false)",

      "Bash(git status*)",
