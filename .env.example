# Repo-root secrets — for tooling, CI, and deploy scripts. Copy to .env
# (gitignored) and fill in before running tools/r2-sync, Netlify deploys,
# or any other build-time integration. Anything here is NOT shipped to
# the browser — see apps/web/.env.example and apps/site/.env.example for
# bundled-into-the-client values.

# ---- Cloudflare R2 ---------------------------------------------------
# Used by tools/r2-sync (unbuilt) to push tilesets / interface art /
# monster art to media.gamecodex.com. Generate a scoped R2 API token
# in the Cloudflare dashboard with Object Read+Write on the project's
# bucket only. Public CDN URL itself is in the per-app .env.example.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=projectvirtue-media
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ---- Netlify ---------------------------------------------------------
# Personal access token for `netlify deploy --prod` from CI. Local
# `netlify link` + `netlify login` works without this; use it only in
# automated pipelines.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID_WEB=
NETLIFY_SITE_ID_SITE=

# ---- GitHub ----------------------------------------------------------
# Optional — for any future GitHub Actions that publish releases or
# touch the gh-pages branch. Defaults to GITHUB_TOKEN inside Actions.
GITHUB_TOKEN=
